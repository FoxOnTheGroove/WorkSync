# MORPH Lab: morph 익스텐션을 모두 올린 데스크톱 앱 (kit_base_editor 기반 축소판).
# 스트리밍은 morph.lab_streaming.kit (이 앱 + livestream).

[package]
title = "MORPH Lab"
version = "0.1.0"
description = "MORPH Omniverse extensions on a minimal editor."
keywords = ["app"]


[dependencies]
# --- morph --- (^ 범위: 이 버전 이상 같은 major. 웹 클라이언트·스모크가 쓰는 기능 기준)
"morph.stream.messaging" = { version = "1.0" }
"morph.perf.monitor" = { version = "1.1" }  # 시스템 지표
"morph.viewport.split" = { version = "1.5" }  # 웹 set_side_ratio
"morph.camera.control" = { version = "1.1" }  # 웹 프리셋 목록·삭제
"morph.stage.loader" = { version = "0.1" }  # 장면 목록·열기 (웹 장면 패널, 스모크 데모 장면)
"morph.annotation.overlay" = { version = "0.4" }  # 뷰포트 주석: 라벨·inlet/outlet·절단면 (사이드카 JSON)

# --- Kit 기본 (kit_base_editor에서 필요한 것만) ---
"omni.activity.profiler" = {}  # RTX 로딩 진행 표시
"omni.activity.pump" = {}
"omni.hydra.engine.stats" = {}  # 해상도/fps HUD
"omni.hydra.rtx" = {}  # 뷰포트 렌더러
"omni.hydra.usdrt_delegate" = {}
"omni.kit.mainwindow" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.menu.common" = { order = 1000 }
"omni.kit.menu.create" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.file" = {}
"omni.kit.primitive.mesh" = {}
"omni.kit.property.bundle" = {}
"omni.kit.stage_template.core" = {}
"omni.kit.viewport.legacy_gizmos" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.display" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.ready" = {}
"omni.kit.viewport.window" = {}
"omni.kit.window.console" = {}
"omni.kit.window.property" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.toolbar" = {}


[settings.persistent.app]
viewport.autoFrame.mode = "first_open"


[settings]
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".windowMenu.label = ""
renderer.gpuEnumeration.glInterop.enabled = false
renderer.asyncInit = true
rtx.ecoMode.enabled = true
rtx.hydra.mdlMaterialWarmup = true
telemetry.enableAnonymousData = false
# 분할화면 꾸밈 (morph.viewport.split 1.1): 탭 숨김, 뷰 여백 0, 도킹 분할선 1px (전역 ImGui 스타일)
exts."morph.viewport.split".hideTabBar = true
exts."morph.viewport.split".viewPadding = 0.0
exts."morph.viewport.split".dockSplitterSize = 1.0
exts."morph.annotation.overlay".editorWindow = true  # 주석 편집 창 "MORPH Annotations" (데스크톱 전용, 스트리밍 앱은 끔)
privacy.externalBuild = true


[settings.app]
# 한글 표시 (주석 라벨·편집 창): 앱 글꼴 + 한글 글리프 범위. 렌더러 시작 때 읽힘 (morph.annotation.overlay 0.3.1 "한글 표시")
font.customFontPath = "C:/Windows/Fonts/malgun.ttf"
font.customRegionFiles = ["${app}/fonts/korean_region.txt"]
content.emptyStageOnStart = true
font.file = "${fonts}/OpenSans-SemiBold.ttf"
font.size = 16
hangDetector.enabled = true
hangDetector.timeout = 120
renderer.skipWhileMinimized = true
window.title = "MORPH Lab"
file.ignoreUnsavedOnExit = true


[settings.app.environment]
name = "MORPH Lab"


[settings.app.exts]
folders.'++' = [
	"${app}/../exts",
	"${app}/../extscache/"
]


[settings.app.viewport.defaults]
fillViewport = true


[[test]]
args = [
	"--/app/file/ignoreUnsavedOnExit=true"
]


########################################################################################################################
# BEGIN GENERATED PART (Remove from 'BEGIN' to 'END' to regenerate)
########################################################################################################################

# Kit SDK Version: 110.1.3+production.349534.56c4c3a1.gl

# Version lock for all dependencies:
[settings.app.exts]
enabled = [
	"omni.kit.viewport.menubar.lighting-107.3.2",
]

########################################################################################################################
# END GENERATED PART
########################################################################################################################
